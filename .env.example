# ============================================================
#  导航站 v2 — Docker Compose 环境变量样例
#
#  用法：
#    cp .env.example .env
#    docker compose up -d --build
# ============================================================

# 对外端口。容器内 nginx 固定监听 80，这里只改宿主机映射。
# 若 8080 被占用（例如宝塔自带的站点），换成 8090 / 9080 等。
NAV_PORT=8080

# 时区
TZ=Asia/Shanghai
