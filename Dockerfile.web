# ============================================================
#  导航站 v2 — Web 镜像（nginx + 前端构建产物）
#
#  阶段 1 用 node 构建 Vue 3 SPA，阶段 2 只把产物拷进 nginx。
#  这样「git clone 完直接 docker compose up -d --build」即可运行，
#  宿主机不需要装 Node，也不需要预先 npm run build。
# ============================================================

# ---------------- 阶段 1：构建前端 ----------------
FROM node:22-alpine AS frontend

# 注意目录层级：vite.config.js 里 outDir 写的是 ../dist，
# 所以必须让当前目录的上一层正好是 /build，产物才会落在 /build/dist。
# 直接把 frontend/ 的内容摊在 /build 下的话，产物会跑到根目录 /dist 去。
WORKDIR /build/frontend

# 先只拷依赖清单：package.json 没动时可以命中缓存，改业务代码不会重装依赖
# .npmrc 里钉的是 registry.npmmirror.com 镜像源（构建更快），仓库里必须有这个文件
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci --no-audit --no-fund

# 再拷源码并构建。产物在 /build/dist
COPY frontend/ ./
RUN npm run build

# ---------------- 阶段 2：nginx ----------------
FROM nginx:1.27-alpine

# 站点配置：后端只暴露 /api/index.php，其余 .php 一律 404
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# 前端产物「摊平」到站点根 —— 与宝塔部署保持一致
# （48x48.ico 在 frontend/public/ 里，构建时会一并进 dist）
COPY --from=frontend /build/dist/ /var/www/html/

# 404 页
COPY 404.html /var/www/html/404.html

# uploads 由 app 容器写入，这里只读挂载，先建好挂载点。
# 属主写成数字 82（alpine 里 www-data 的 uid）：万一这个卷是被 web 容器
# 抢先初始化的，属主也不会变成 root，省得 app 那边写不进去。
RUN mkdir -p /var/www/html/uploads && chown 82:82 /var/www/html/uploads

EXPOSE 80
